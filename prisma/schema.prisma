generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Importance {
  critical
  high
  normal
}

enum RiskLevel {
  low
  medium
  high
  critical
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Artículos ingeridos por RSS de medios colombianos reales (El Tiempo, Semana, Infobae —
// ver lib/news/sources.ts). department se detecta por keyword-match (lib/news/departments.ts,
// 'Nacional' si no hay coincidencia); riskLevel/importance/aiSummary los asigna Claude Haiku
// a partir del título+resumen reales (lib/ai/classify-article.ts) — nunca se inventan hechos.
// municipality queda sin poblar (no hay detección a ese nivel todavía) en vez de fabricarlo.
model NewsArticle {
  id           String     @id @default(cuid())
  title        String
  summary      String
  fullText     String?
  source       String
  sourceUrl    String     @unique
  department   String
  municipality String?
  publishedAt  DateTime
  category     String
  importance   Importance
  riskLevel    RiskLevel
  aiSummary    String
  tags         String[]
  createdAt    DateTime   @default(now())

  @@index([department])
  @@index([publishedAt])
}

// Snapshot diario del modelo de estabilidad de espectro por departamento (banda VHF/UHF),
// calculado a partir de clima real de Open-Meteo. Es histórico puramente derivado —
// no telemetría de hardware — pensado para poder graficar tendencias y líneas de tiempo.
model SpectrumSnapshot {
  id              String   @id @default(cuid())
  department      String
  capturedAt      DateTime @default(now())
  tempC           Float
  humidityPct     Float
  precipitationMm Float
  stability       String
  attenuationDbKm Float
  refractivity    Float

  @@index([department, capturedAt])
}

// Boletín/briefing generado por IA a partir de datos reales ya persistidos (SpectrumSnapshot,
// GaoSourceItem) — el modelo solo redacta sobre hechos que le pasamos, nunca inventa cifras.
// sourceSummary guarda cuántas filas de cada fuente se usaron, para poder auditar el boletín.
model Briefing {
  id            String   @id @default(cuid())
  kind          String // 'diario' | 'ejecutivo'
  content       String
  sourceSummary Json
  generatedAt   DateTime @default(now())

  @@index([kind, generatedAt])
}

// Artículos ingeridos por RSS desde organizaciones independientes de monitoreo
// de conflicto armado (INDEPAZ, CERAC, PARES). Nunca contenido publicado
// directamente por un actor armado — solo terceros que reportan/analizan.
model GaoSourceItem {
  id              String   @id @default(cuid())
  source          String
  title           String
  link            String   @unique
  summary         String
  publishedAt     DateTime
  categories      String[]
  mentionedGroups String[]
  createdAt       DateTime @default(now())

  @@index([source])
  @@index([publishedAt])
}
